# Sharp secrets template — copy to datas/sharp/secrets.env and fill the values.
#
#   cp secrets.env.example datas/sharp/secrets.env
#   $EDITOR datas/sharp/secrets.env
#
# This file is tool-local and can move with the folder. NEVER commit the filled
# copy: datas/sharp/secrets.env and license_signing_key.b64 are excluded from
# git and from every package script. Every value below is optional — only the
# keys referenced by your dispatch.yaml workers / features need to be set.

# Model provider token used by the claude-code worker (dispatch.yaml workers
# with env SHARP_ANTHROPIC_AUTH_TOKEN).
SHARP_ANTHROPIC_AUTH_TOKEN=

# Anthropic-compatible endpoint overrides (optional; default = Anthropic API).
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# Model provider tokens for other workers / adapters (fill what you use):
# OPENAI_API_KEY=
# PI_API_KEY=

# Backend auth: shared token between the server and the dispatcher. If unset
# the server generates and persists its own token next to the database on first
# run (single-host launcher case). Set it explicitly for split deployments.
# SHARP_SERVER_TOKEN=
